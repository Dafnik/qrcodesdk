---
import Default from '@astrojs/starlight/components/Sidebar.astro';
---

<Default {...Astro.props}>
  <slot />
</Default>

<script>
  function centerSelectedSidebarItem() {
    const sidebar = document.querySelector<HTMLElement>('#starlight__sidebar');

    const selectedMenuItem = sidebar?.querySelector<HTMLElement>("a[aria-current='page']");

    if (!sidebar || !selectedMenuItem) return;

    const sidebarRect = sidebar.getBoundingClientRect();
    const itemRect = selectedMenuItem.getBoundingClientRect();

    /*
     * Consider the item comfortably visible when it is inside the
     * middle 50% of the sidebar. This prevents unnecessary scrolling
     * while avoiding items sitting directly against an edge.
     */
    const edgePadding = sidebar.clientHeight * 0.25;

    const isComfortablyVisible =
      itemRect.top >= sidebarRect.top + edgePadding &&
      itemRect.bottom <= sidebarRect.bottom - edgePadding;

    if (isComfortablyVisible) return;

    // Calculate the scroll position required to center the item.
    const targetScrollTop =
      sidebar.scrollTop +
      itemRect.top -
      sidebarRect.top -
      (sidebar.clientHeight - itemRect.height) / 2;

    // Prevent scrolling beyond the sidebar's boundaries.
    const maximumScrollTop = sidebar.scrollHeight - sidebar.clientHeight;

    const clampedScrollTop = Math.max(0, Math.min(targetScrollTop, maximumScrollTop));

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    sidebar.scrollTo({
      top: clampedScrollTop,
      behavior: prefersReducedMotion ? 'auto' : 'smooth',
    });
  }

  function scheduleSidebarCentering() {
    // Two frames give Starlight and the browser time to restore
    // disclosure state and complete layout.
    requestAnimationFrame(() => {
      requestAnimationFrame(centerSelectedSidebarItem);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleSidebarCentering, {once: true});
  } else {
    scheduleSidebarCentering();
  }

  // Also runs when a page is restored from the back/forward cache.
  window.addEventListener('pageshow', scheduleSidebarCentering);
</script>
