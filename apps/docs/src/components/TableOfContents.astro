---
import Default from '@astrojs/starlight/components/TableOfContents.astro';
import PackageCard from './package-card.astro';
import SupportCard from './support-card.astro';
---

<Default>
  <slot />
</Default>

<PackageCard class="mt-8" />

<SupportCard class="mt-8" />

<style>
  /*
   * Starlight caps the right sidebar content at a quarter of the remaining viewport, which leaves a
   * gap next to it between 72rem and ~90rem where the column is wider than that cap.
   */
  :global(.right-sidebar-panel .sl-container) {
    max-width: none;
  }

  /* Keep nested headings focused on the section currently being read. */
  :global(starlight-toc li > ul) {
    display: none;
  }

  :global(starlight-toc li:has(> a[aria-current='true']) > ul),
  :global(starlight-toc li:has(ul a[aria-current='true']) > ul) {
    display: block;
  }
</style>
