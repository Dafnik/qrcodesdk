---
import {Card} from '@astrojs/starlight/components';
import {AngularPlaygroundPreview} from '../playground/angular/angular-playground-preview.ts';
import {PlaygroundControls} from '../playground/angular/playground-controls.ts';
import {PlaygroundCode} from '../playground/angular/playground-code.ts';
import {CliPlaygroundPreview} from '../playground/angular/cli-playground-preview.ts';
import QRCodeReactPlaygroundPreview from '../playground/QRCodeReactPlaygroundPreview';
import QRCodeSveltePlaygroundPreview from '../playground/QRCodeSveltePlaygroundPreview.svelte';
import QRCodeVuePlaygroundPreview from '../playground/QRCodeVuePlaygroundPreview.vue';
---

<script>
  import {startQrQuerySync} from '../playground/query-sync.ts';

  startQrQuerySync({
    debounceMs: 150,
  });
</script>

<section class="not-content w-full min-w-0" aria-label="QR code package playground">
  <div class="grid min-w-0 grid-cols-1 items-start gap-4 xl:grid-cols-2">
    <Card title="">
      <PlaygroundControls client:load />
    </Card>
    <div class="min-w-0 xl:sticky xl:top-20">
      <div class="grid min-w-0 grid-cols-1 gap-8">
        <div class="grid min-h-104 content-center place-items-center overflow-auto rounded-[0.5rem] border border-dashed border-(--sl-color-gray-5) bg-[linear-gradient(45deg,rgb(255_255_255_/_0.04)_25%,transparent_25%),linear-gradient(-45deg,rgb(255_255_255_/_0.04)_25%,transparent_25%),linear-gradient(45deg,transparent_75%,rgb(255_255_255_/_0.04)_75%),linear-gradient(-45deg,transparent_75%,rgb(255_255_255_/_0.04)_75%)] bg-size-[1.2rem_1.2rem] bg-position-[0_0,0_0.6rem,0.6rem_-0.6rem,-0.6rem_0] p-4">
          <QRCodeReactPlaygroundPreview client:only="react" />
          <QRCodeSveltePlaygroundPreview client:only="svelte" />
          <QRCodeVuePlaygroundPreview client:only="vue" />
          <AngularPlaygroundPreview client:load />
          <CliPlaygroundPreview client:load />
        </div>

        <div class="min-w-0">
          <PlaygroundCode client:load />
        </div>
      </div>
    </div>
  </div>
</section>
