---
import {createBundleJsUrl, createPackageBadges} from '../utils/index.js';

const route = Astro.locals.starlightRoute;
const packageName = route.entry.data.packageName;
const worksWith = route.entry.data.worksWith;

const bundleJsUrl = packageName ? createBundleJsUrl(packageName) : null;

let size = 'N/A';
if (bundleJsUrl) {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 5_000);
  try {
    const response = await fetch(bundleJsUrl, {signal: controller.signal});
    if (response.ok) {
      const data = await response.json();
      size = data.size?.size || 'N/A';
    }
  } catch (error) {
    console.error('Failed to fetch bundle size:', error);
  } finally {
    clearTimeout(timeout);
  }
}

const badges = packageName ? createPackageBadges(packageName, {bundledSize: size}) : [];
---

{
  packageName && (
    <div class="flex flex-wrap gap-1.5 items-center not-content">
      {badges.map(({alt, imageUrl, href}) =>
        href ? (
          <a href={href} target="_blank" rel="noopener noreferrer">
            <img src={imageUrl} alt={alt} loading="lazy" />
          </a>
        ) : (
          <img src={imageUrl} alt={alt} loading="lazy" />
        ),
      )}

      {worksWith?.length && (
        <div class="inline-flex overflow-hidden rounded-[3px] text-[11px] font-mono font-normal leading-5 text-white shadow-sm">
          <span class="bg-[#555] px-1">works with</span>
          <div class="bg-[#7469B6] px-1 flex items-center gap-1">
            {worksWith.map((env) => (
              <div class="relative h-4" style="aspect-ratio: 256 / 292">
                <img
                  src={'/logos/' + env.toLowerCase() + '.svg'}
                  width="256"
                  height="292"
                  alt={'This package works with ' + env}
                  title={'This package works with ' + env}
                  class="h-4 select-none brightness-0 invert"
                />
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  )
}
