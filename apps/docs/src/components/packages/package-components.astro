---
import {
  PACKAGE_COMPONENTS,
  getPackageComponentProps,
  splitInlineCode,
} from '../../utils/package-components.mjs';

interface Props {
  selector?: boolean;
}

const {selector = false} = Astro.props;
const props = getPackageComponentProps(Astro.locals.starlightRoute.entry.data.packageName);
---

<table>
  <thead>
    <tr>
      <th>Component</th>
      {selector && <th>Selector</th>}
      <th>Output</th>
      <th>Download support</th>
    </tr>
  </thead>

  <tbody>
    {PACKAGE_COMPONENTS.map((item) => (
      <tr>
        <td>
          <code>{item.component}</code>
        </td>
        {selector && (
          <td>
            <code>{item.selector}</code>
          </td>
        )}
        <td>
          <code>{item.output}</code>
        </td>
        <td>{item.download}</td>
      </tr>
    ))}
  </tbody>
</table>

<h3 id="component-props">Component props</h3>

<table>
  <thead>
    <tr>
      <th>Prop</th>
      <th>Type</th>
      <th>Description</th>
    </tr>
  </thead>

  <tbody>
    {props.map((item) => (
      <tr>
        {[item.prop, item.type, item.description].map((cell) => (
          <td>
            {splitInlineCode(cell).map((part) =>
              part.code ? <code>{part.text}</code> : part.text,
            )}
          </td>
        ))}
      </tr>
    ))}
  </tbody>
</table>
