---
import {Code} from '@astrojs/starlight/components';

interface Props {
  accessibility?: boolean;
  compressionLevel?: boolean;
}

const {accessibility = true, compressionLevel = false} = Astro.props;

const options = [
  ['`style.moduleSize`', 'All', '`number`', '`5`', 'Pixel size of each QR module.'],
  ['`style.quietZone`', 'All', '`number`', '`4`', 'Quiet-zone width in modules.'],
  ['`style.foreground`', 'All', '`QRCodeColor`', "`'#000000'`", 'Default dark color.'],
  ['`style.background`', 'All', '`QRCodeColor`', "`'#ffffff'`", 'Background color.'],
  [
    '`style.modules`',
    'All',
    '`{shape?: QRCodeModuleShape; color?: QRCodeColor}`',
    "`{shape: 'square'}`",
    'Ordinary module shape and optional color.',
  ],
  [
    '`style.finder.outer`',
    'All',
    '`{shape?: QRCodeFinderShape; color?: QRCodeColor}`',
    "`{shape: 'square'}`",
    'Finder-ring shape and optional color.',
  ],
  [
    '`style.finder.center`',
    'All',
    '`{shape?: QRCodeFinderShape; color?: QRCodeColor}`',
    "`{shape: 'square'}`",
    'Finder-center shape and optional color.',
  ],
  [
    '`image.source`',
    'All',
    'Renderer-specific source',
    '`undefined`',
    'Image already loaded by the caller.',
  ],
  ['`image.size`', 'All', '`number`', '`0.4`', 'Relative centered image-box size.'],
  ['`image.padding`', 'All', '`number`', '`1`', 'Clear padding in QR modules.'],
  ['`image.clearBackground`', 'All', '`boolean`', '`true`', 'Clears modules behind the image.'],
  ...(accessibility
    ? [
        ['`accessibility.alt`', 'Image', '`string`', "`''`", 'Image `alt` property.'],
        [
          '`accessibility.ariaLabel`',
          'SVG, Canvas, Image',
          '`string`',
          '`undefined`',
          'Accessible name.',
        ],
        ['`accessibility.title`', 'SVG, Canvas, Image', '`string`', '`undefined`', 'Output title.'],
      ]
    : []),
  ...(compressionLevel
    ? [
        [
          '`compression.level`',
          '',
          '`number`',
          '`9`',
          'PNG compression from `0` (fast) to `9` (small).',
        ],
      ]
    : []),
];

const optionTypes = `export interface QRCodeVisualStyle {
  moduleSize?: number;
  quietZone?: number;
  foreground?: QRCodeColor;
  background?: QRCodeColor;
  modules?: {shape?: QRCodeModuleShape; color?: QRCodeColor};
  finder?: {
    outer?: {shape?: QRCodeFinderShape; color?: QRCodeColor};
    center?: {shape?: QRCodeFinderShape; color?: QRCodeColor};
  };
};`;
---

<table>
  <thead>
    <tr>
      <th>Option</th>
      <th>Type / Default</th>
      <th>Description</th>
    </tr>
  </thead>

  <tbody>
    {
      options.map(([option, components, type, defaultValue, description]) => (
        <tr>
          <td>
            <code>{option.replaceAll('`', '')}</code>
            {components !== 'All' && components ? ` (${components})` : ''}
          </td>
          <td>
            {type.startsWith('`') ? <code>{type.replaceAll('`', '')}</code> : type}
            <br />
            Default: <code>{defaultValue.replaceAll('`', '')}</code>
          </td>
          <td>{description}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<p>The following options are available for styling:</p>

<Code code={optionTypes} lang="ts" />

<h4>Restrictions</h4>

<ul>
  <li>
    Colors must be exactly <code>#RRGGBB</code> or <code>#RRGGBBAA</code>.
  </li>
  <li>
    <code>moduleSize</code> requires a positive safe integer (<code>&gt;0</code>) and
    <code>quietZone</code> a non-negative safe integer (<code>&gt;=0</code>).
  </li>
  <li>
    Module, finder-ring, and finder-center options pass through to every component. Their optional
    colors independently inherit <code>style.foreground</code>.
  </li>
  <li>
    Module shapes are <code>square</code>, <code>circle</code>, <code>rounded</code>,
    <code>extra-rounded</code>, <code>diagonal</code>, and <code>diagonal-rounded</code>. Finder
    shapes are <code>square</code>, <code>rounded</code>, <code>extra-rounded</code>, and
    <code>circle</code>.
  </li>
</ul>
