{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/core/src/**",
        "$TURBO_ROOT$/packages/perf/baseline/**",
        "$TURBO_ROOT$/packages/perf/reports/**"
      ]
    },
    "check-readmes": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/core/src/**"]
    },
    "generate-readmes": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["check-readmes"]
    },
    "preview": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "start": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "@qrcodesdk/cli#build"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/core/src/**"]
    }
  }
}
