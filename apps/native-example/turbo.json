{
  "extends": ["//"],
  "tasks": {
    "android": {"cache": false, "dependsOn": ["^build"], "interactive": true, "persistent": true},
    "generate:center-logo": {"cache": false},
    "ios": {"cache": false, "dependsOn": ["^build"], "interactive": true, "persistent": true},
    "native:cache:ios": {
      "cache": false,
      "passThroughEnv": ["CCACHE_DIR", "CCACHE_MAXSIZE", "GITHUB_OUTPUT", "DEVELOPER_DIR"]
    },
    "native:tools": {"cache": false},
    "start": {"cache": false, "dependsOn": ["^build"], "interactive": true, "persistent": true},
    "test": {"dependsOn": ["^build"]},
    "test:native:android": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "CI",
        "JAVA_HOME",
        "ANDROID_HOME",
        "ANDROID_SDK_ROOT",
        "ANDROID_SERIAL",
        "MAESTRO_DRIVER_STARTUP_TIMEOUT",
        "QRCODESDK_NATIVE_DEVICE"
      ]
    },
    "test:native:ios": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "CCACHE_DIR",
        "CCACHE_MAXSIZE",
        "USE_CCACHE",
        "CI",
        "PATH",
        "JAVA_HOME",
        "MAESTRO_DRIVER_STARTUP_TIMEOUT",
        "QRCODESDK_NATIVE_DEVICE",
        "DEVELOPER_DIR"
      ]
    }
  }
}
