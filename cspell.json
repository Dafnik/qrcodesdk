{
  "dictionaries": ["project-words", "people-words", "library-words"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.github/cspell/project-words.txt"
    },
    {
      "name": "people-words",
      "path": "./.github/cspell/people-words.txt"
    },
    {
      "name": "library-words",
      "path": "./.github/cspell/library-words.txt"
    }
  ],
  "ignorePaths": [
