{
  "name": "qrcodesdk",
  "private": true,
  "scripts": {
    "benchmark": "turbo run benchmark --filter=@repo/benchmarks",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:coverage": "node scripts/coverage.mjs",
    "test:roundtrips": "turbo run test:roundtrips --filter=@repo/core-testing --filter=@qrcodesdk/browser --filter=@qrcodesdk/node",
    "terminology": "node scripts/check-terminology.mjs",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "clean:deep": "turbo run clean && rm -rf node_modules",
    "lint": "turbo run lint",
    "cspell": "cspell \"**\" --gitignore --quiet",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run check",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version",
    "release:tag": "changeset git-tag",
    "pack:runtime": "node scripts/pack-runtime.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "cspell": "10.3.6",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "nyc": "18.0.0",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-organize-attributes": "1.0.0",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
