{
  "name": "@repo/core-testing",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./decoder": "./dist/decoder/index.mjs",
    "./decoder/node": "./dist/decoder/node.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest --watch false --exclude 'tests/svg/*roundtrip.e2e.spec.ts' --exclude 'tests/micro/*roundtrip.e2e.spec.ts'",
    "test:coverage:raw": "vitest --coverage --mode coverage --watch false",
    "test:roundtrips": "vitest --watch false tests/svg/*roundtrip.e2e.spec.ts tests/micro/*roundtrip.e2e.spec.ts",
    "check-types": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "lint": "eslint scripts src tests --max-warnings 0",
    "clean": "rm -rf .turbo dist",
    "test:snapshots": "vitest run tests/svg/svg-renderer.snapshot.e2e.spec.ts tests/text/text-renderer.snapshot.e2e.spec.ts"
  },
  "dependencies": {
    "@qrcodesdk/core": "workspace:*",
    "zxing-wasm": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "qrcode": "catalog:",
    "qrcode-generator": "catalog:",
    "sharp": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
