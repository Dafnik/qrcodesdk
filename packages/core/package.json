{
  "name": "@qrcodesdk/core",
  "type": "module",
  "version": "0.0.0",
  "description": "Runtime-neutral QR code generation for any JavaScript runtime with native ESM, ES2020, and TextEncoder. Build matrices, SVG, terminal text, or custom output.",
  "sideEffects": false,
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Dafnik",
    "email": "contact@dafnik.me",
    "url": "https://dafnik.me"
  },
  "keywords": [
    "typescript",
    "types",
    "qr-code",
    "qrcode",
    "qr",
    "code",
    "esm",
    "modules",
    "module",
    "runtime-agnostic",
    "node",
    "browser",
    "deno",
    "bun"
  ],
  "homepage": "https://qrcodesdk.dev/packages/core",
  "repository": {
    "type": "git",
    "url": "git@github.com:Dafnik/qrcodesdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Dafnik/qrcodesdk/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Dafnik"
    },
    {
      "type": "liberapay",
      "url": "https://liberapay.com/Dafnik"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "cp ../../LICENSE .",
    "watch": "tsdown --watch",
    "test": "vitest --watch false",
    "test:runtime:dist": "node runtime/smoke-dist.mjs",
    "test:runtime:browser": "node runtime/smoke-browser.mjs",
    "test:coverage:raw": "vitest --coverage --watch false",
    "check-types": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "lint": "eslint src tests runtime --max-warnings 0",
    "clean": "rm -rf .turbo dist",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "playwright": "1.61.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
