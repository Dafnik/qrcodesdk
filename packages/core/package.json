{
  "name": "@qrcodesdk/core",
  "type": "module",
  "version": "0.0.6",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Runtime-neutral QR code generation for any JavaScript runtime with native ESM, ES2020, and TextEncoder. Build matrices, SVG, terminal text, or custom output.",
  "sideEffects": false,
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Dafnik",
    "email": "contact@dafnik.me",
    "url": "https://dafnik.me"
  },
  "keywords": [
    "typescript",
    "types",
    "qr-code",
    "qrcode",
    "qr",
    "code",
    "esm",
    "modules",
    "module",
    "node",
    "browser",
    "bun"
  ],
  "homepage": "https://qrcodesdk.dev/packages/core",
  "repository": {
    "type": "git",
    "url": "git@github.com:Dafnik/qrcodesdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Dafnik/qrcodesdk/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Dafnik"
    },
    {
      "type": "liberapay",
      "url": "https://liberapay.com/Dafnik"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./error": "./dist/error.mjs",
    "./internal": "./dist/internal.mjs",
    "./internal/gif": "./dist/internal/gif.mjs",
    "./internal/jpeg": "./dist/internal/jpeg.mjs",
    "./internal/raster": "./dist/internal/raster.mjs",
    "./internal/webp": "./dist/internal/webp.mjs",
    "./internal/zlib": "./dist/internal/zlib.mjs",
    "./kanji": "./dist/kanji.mjs",
    "./matrix": "./dist/matrix.mjs",
    "./micro": "./dist/micro.mjs",
    "./payload": "./dist/payload.mjs",
    "./rmqr": "./dist/rmqr.mjs",
    "./segmenter": "./dist/segmenter.mjs",
    "./style": "./dist/style.mjs",
    "./svg": "./dist/svg.mjs",
    "./text": "./dist/text.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "cp ../../LICENSE .",
    "watch": "tsdown --watch",
    "test": "vitest --watch false && node ../core-testing/scripts/verify-package-artifact.mjs",
    "test:coverage:raw": "vitest --coverage --watch false",
    "check-types": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "lint": "eslint scripts src tests runtime --max-warnings 0",
    "generate:kanji-table": "node scripts/generate-kanji-table.mjs",
    "clean": "rm -rf .turbo dist",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "sharp": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
