{
  "name": "@repo/perf",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./baseline/size.json": "./baseline/size.json",
    "./baseline/speed.json": "./baseline/speed.json",
    "./budget": "./src/size/budget.ts",
    "./report-types": "./src/report-types.ts",
    "./statistics": "./src/speed/statistics.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "report:size": "node src/size/cli.ts",
    "check:size": "node src/size/cli.ts --check",
    "report:speed": "node src/speed/cli.ts --target=node",
    "report:speed:browser": "node src/speed/cli.ts --target=browser",
    "check-types": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest --watch false",
    "clean": "rm -rf .turbo .cache reports && git worktree prune"
  },
  "devDependencies": {
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/build": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/core": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@qrcodesdk/angular": "workspace:*",
    "@qrcodesdk/browser": "workspace:*",
    "@qrcodesdk/core": "workspace:*",
    "@qrcodesdk/node": "workspace:*",
    "@qrcodesdk/react": "workspace:*",
    "@qrcodesdk/svelte": "workspace:*",
    "@qrcodesdk/vue": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "webpack": "5.112.2"
  }
}
