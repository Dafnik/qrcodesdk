{
  "name": "@qrcodesdk/react-native",
  "type": "module",
  "version": "0.0.5",
  "description": "@qrcodesdk/react-native provides React Native components for rendering QR codes with react-native-svg or as PNG, WebP, GIF, and JPEG images.",
  "sideEffects": false,
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Dafnik",
    "email": "contact@dafnik.me",
    "url": "https://dafnik.me"
  },
  "keywords": [
    "typescript",
    "types",
    "qr-code",
    "qrcode",
    "qr",
    "code",
    "esm",
    "modules",
    "module",
    "react",
    "react-native",
    "expo",
    "ios",
    "android"
  ],
  "homepage": "https://qrcodesdk.dev/packages/react-native",
  "repository": {
    "type": "git",
    "url": "git@github.com:Dafnik/qrcodesdk.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/Dafnik/qrcodesdk/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Dafnik"
    },
    {
      "type": "liberapay",
      "url": "https://liberapay.com/Dafnik"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "cp ../../LICENSE .",
    "watch": "tsdown --watch",
    "test": "vitest --watch false && node ../core-testing/scripts/verify-package-artifact.mjs",
    "test:coverage:raw": "vitest --coverage --watch false",
    "check-types": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "lint": "eslint src tests runtime --max-warnings 0",
    "clean": "rm -rf .turbo dist",
    "prepublishOnly": "pnpm run build",
    "test:react-native-runtime": "node runtime/smoke-package.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.79.0",
    "react-native-svg": ">=15.0.0"
  },
  "dependencies": {
    "@qrcodesdk/core": "workspace:*"
  },
  "devDependencies": {
    "@qrcodesdk/core": "workspace:*",
    "@repo/core-testing": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:",
    "sharp": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
