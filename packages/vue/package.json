{
  "name": "@qrcodesdk/vue",
  "type": "module",
  "version": "0.0.1",
  "description": "@qrcodesdk/vue provides Vue components for rendering QR codes as SVG, PNG-backed image elements, and canvas elements.",
  "sideEffects": false,
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Dafnik",
    "email": "contact@dafnik.me",
    "url": "https://dafnik.me"
  },
  "keywords": [
    "typescript",
    "types",
    "qr-code",
    "qrcode",
    "qr",
    "code",
    "esm",
    "modules",
    "module",
    "vue"
  ],
  "homepage": "https://qrcodesdk.dev/packages/vue",
  "repository": {
    "type": "git",
    "url": "git@github.com:Dafnik/qrcodesdk.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Dafnik/qrcodesdk/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Dafnik"
    },
    {
      "type": "liberapay",
      "url": "https://liberapay.com/Dafnik"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "cp ../../LICENSE .",
    "watch": "tsdown --watch",
    "test": "vitest --watch false && node ../core-testing/scripts/verify-package-artifact.mjs",
    "test:coverage:raw": "vitest --coverage --watch false",
    "check-types": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "lint": "eslint src tests runtime --max-warnings 0",
    "clean": "rm -rf .turbo dist",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@qrcodesdk/browser": "workspace:^",
    "@qrcodesdk/core": "workspace:^",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@qrcodesdk/browser": "workspace:*",
    "@qrcodesdk/core": "workspace:*",
    "@repo/core-testing": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "jsdom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
