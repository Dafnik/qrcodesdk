{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "//#cspell": {
      "cache": false
    },
    "//#format": {
      "cache": false
    },
    "//#format:check": {
      "cache": false
    },
    "//#pack:runtime": {
      "cache": false,
      "dependsOn": [
        "@qrcodesdk/core#build",
        "@qrcodesdk/browser#build",
        "@qrcodesdk/node#build",
        "@qrcodesdk/cli#build",
        "@qrcodesdk/react#build",
        "@qrcodesdk/angular#build",
        "@qrcodesdk/vue#build",
        "@qrcodesdk/svelte#build"
      ],
      "env": ["QRCODESDK_PACKAGES"]
    },
    "//#terminology": {
      "cache": false
    },
    "//#test:coverage": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": [
        "//#format:check",
        "//#cspell",
        "//#terminology",
        "build",
        "test",
        "lint",
        "check-types"
      ]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "clean": {
      "cache": false
    },
    "lint": {},
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core-testing/scripts/verify-package-artifact.mjs"
      ]
    },
    "test:coverage:raw": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:roundtrips": {
      "dependsOn": ["build"]
    }
  },
  "ui": "tui"
}
