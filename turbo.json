{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["packages/core-testing/scripts/verify-package-artifact.mjs"],
  "globalEnv": [
    "QRCODESDK_BROWSER",
    "QRCODESDK_CONSUMER",
    "QRCODESDK_FRAMEWORK",
    "QRCODESDK_FRAMEWORK_VERSION",
    "QRCODESDK_PACKAGES",
    "QRCODESDK_RUNTIME",
    "UPDATE_PNG_SNAPSHOTS",
    "UPDATE_SVG_SNAPSHOTS",
    "UPDATE_TEXT_SNAPSHOTS"
  ],
  "tasks": {
    "//#cspell": {
      "cache": false
    },
    "//#format:check": {
      "cache": false
    },
    "benchmark": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "!.turbo/**", "!.astro-cache/**"]
    },
    "check": {
      "cache": false,
      "dependsOn": ["//#format:check", "//#cspell", "build", "test", "lint", "check-types"]
    },
    "check-documentation": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "check-performance": {
      "cache": false
    },
    "check-readmes": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "clean": {
      "cache": false
    },
    "generate-performance": {
      "cache": false
    },
    "generate-readmes": {
      "cache": false
    },
    "lint": {},
    "preview": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "test:coverage:raw": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:roundtrips": {
      "dependsOn": ["build", "^build"]
    }
  },
  "ui": "tui"
}
