{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["packages/core-testing/scripts/verify-package-artifact.mjs"],
  "globalEnv": [
    "QRCODESDK_BROWSER",
    "QRCODESDK_CONSUMER",
    "QRCODESDK_FRAMEWORK",
    "QRCODESDK_FRAMEWORK_VERSION",
    "QRCODESDK_RUNTIME",
    "UPDATE_PNG_SNAPSHOTS",
    "UPDATE_SVG_SNAPSHOTS",
    "UPDATE_TEXT_SNAPSHOTS"
  ],
  "globalPassThroughEnv": ["QRCODESDK_PACKAGES"],
  "tasks": {
    "//#cspell": {
      "cache": false
    },
    "//#format": {
      "cache": false
    },
    "//#format:check": {
      "cache": false
    },
    "//#pack:runtime": {
      "cache": false,
      "dependsOn": [
        "@qrcodesdk/core#build",
        "@qrcodesdk/browser#build",
        "@qrcodesdk/node#build",
        "@qrcodesdk/cli#build",
        "@qrcodesdk/react#build",
        "@qrcodesdk/angular#build",
        "@qrcodesdk/vue#build",
        "@qrcodesdk/svelte#build"
      ],
      "env": ["QRCODESDK_PACKAGES"]
    },
    "//#terminology": {
      "cache": false
    },
    "//#test:browser-runtime": {
      "cache": false
    },
    "//#test:framework-runtime": {
      "cache": false,
      "env": ["QRCODESDK_PACKAGES"]
    },
    "//#update:runtime-fixtures": {
      "cache": false
    },
    "benchmark": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "benchmark:matrix": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "benchmark:styler": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "!.turbo/**", "!.astro-cache/**"]
    },
    "check": {
      "dependsOn": [
        "//#format:check",
        "//#cspell",
        "//#terminology",
        "build",
        "test",
        "lint",
        "check-types"
      ]
    },
    "check-performance": {
      "cache": false
    },
    "check-readmes": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "clean": {
      "cache": false
    },
    "generate-performance": {
      "cache": false
    },
    "generate-readmes": {
      "cache": false
    },
    "lint": {},
    "preview": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "test:coverage:raw": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:roundtrips": {
      "dependsOn": ["build", "^build"]
    }
  },
  "ui": "tui"
}
